// 每行是：字段号 类型 名字。字段号写在协议里，生成器不补、不重排。
// 容器写成 vector<T>、map<K, V>。string 就是 std::string。
// rpcdata 名字后面加 key，才生成比较器，才能当 map 键。这种结构不生成 JSON。

rpcdata Inner {
    0 int32_t n;
    1 string s;
}

rpcdata EchoKeyPart key {
    0 int32_t n;
}

rpcdata EchoKey key {
    0 EchoKeyPart part;
    1 string name;
}

rpcdata AllTypesData {
    0 int8_t c;
    1 int16_t s;
    2 int32_t i;
    3 int64_t l;
    4 int64_t i64;
    5 float f;
    6 double d;
    7 Bytes raw;
    8 string msg;
    9 vector<int32_t> nums;
    10 vector<string> words;
    11 Inner child;
    12 vector<Inner> children;
    13 map<int32_t, string> table;
    14 map<string, Inner> named;
    15 uint8_t u8;
    16 uint16_t u16;
    17 uint32_t u32;
    18 uint64_t u64;
    19 vector<uint64_t> unums;
    20 int32_t gap;
    21 map<uint32_t, string> utable;
    22 map<uint64_t, string> ubig;
    23 map<EchoKey, string> keyed;
}

rpcdata AllEchoReq {
    0 AllTypesData data;
}

rpcdata AllEchoRes {
    0 AllTypesData data;
    1 int32_t code;
}

rpcdata HoldReq {
    0 int32_t delay_ms;
    1 int32_t mark;
}

rpcdata HoldRes {
    0 int32_t mark;
}

// JSON 能表达的全量结构。结构当 map 键的字段不在这里。
rpcdata JsonAll {
    0 int8_t c;
    1 int16_t s;
    2 int32_t i;
    3 int64_t l;
    4 int64_t i64;
    5 float f;
    6 double d;
    7 Bytes raw;
    8 string msg;
    9 vector<int32_t> nums;
    10 vector<string> words;
    11 Inner child;
    12 vector<Inner> children;
    13 map<int32_t, string> table;
    14 map<string, Inner> named;
    15 uint8_t u8;
    16 uint16_t u16;
    17 uint32_t u32;
    18 uint64_t u64;
    19 vector<uint64_t> unums;
    20 int32_t gap;
    21 map<uint32_t, string> utable;
    22 map<uint64_t, string> ubig;
}

// 请求和回复共用一个协议号。调用号最高位区分请求和回包。
rpc AllEcho { id 3001; request AllEchoReq; response AllEchoRes; timeout 25; }
rpc Hold { id 3002; request HoldReq; response HoldRes; timeout 25; }
