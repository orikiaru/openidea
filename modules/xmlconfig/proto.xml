// 每行是：字段号 类型 名字。字段号写在协议里，生成器不补、不重排。
// 容器写成 vector<T>、map<K, V>。string 就是 std::string。
// rpcdata 名字后面加 key，才生成比较器，才能当 map 键。这种结构不生成 JSON。

rpcdata Inner {
    0 int32_t iNumber json n;
    1 string sText json s;
}

rpcdata EchoKeyPart key {
    0 int32_t iNumber json n;
}

rpcdata EchoKey key {
    0 EchoKeyPart stPart json part;
    1 string sName json name;
}

rpcdata AllTypesData {
    0 int8_t iInt8 json c;
    1 int16_t iInt16 json s;
    2 int32_t iInt32 json i;
    3 int64_t iInt64 json l;
    4 int64_t iAlternateInt64 json i64;
    5 float fFloat json f;
    6 double dDouble json d;
    7 Bytes stRawData json raw;
    8 string sMessage json msg;
    9 vector<int32_t> vNumbers json nums;
    10 vector<string> vWords json words;
    11 Inner stChild json child;
    12 vector<Inner> vChildren json children;
    13 map<int32_t, string> mTable json table;
    14 map<string, Inner> mNamed json named;
    15 uint8_t iUnsigned8 json u8;
    16 uint16_t iUnsigned16 json u16;
    17 uint32_t iUnsigned32 json u32;
    18 uint64_t iUnsigned64 json u64;
    19 vector<uint64_t> vUnsignedNumbers json unums;
    20 int32_t iGap json gap;
    21 map<uint32_t, string> mUnsignedTable json utable;
    22 map<uint64_t, string> mLargeUnsignedTable json ubig;
    23 map<EchoKey, string> mKeyed json keyed;
}

rpcdata AllEchoReq {
    0 AllTypesData stData json data;
}

rpcdata AllEchoRes {
    0 AllTypesData stData json data;
    1 int32_t iCode json code;
}

rpcdata HoldReq {
    0 int32_t iDelayMilliseconds json delay_ms;
    1 int32_t iMark json mark;
}

rpcdata HoldRes {
    0 int32_t iMark json mark;
}

// JSON 能表达的全量结构。结构当 map 键的字段不在这里。
rpcdata JsonAll {
    0 int8_t iInt8 json c;
    1 int16_t iInt16 json s;
    2 int32_t iInt32 json i;
    3 int64_t iInt64 json l;
    4 int64_t iAlternateInt64 json i64;
    5 float fFloat json f;
    6 double dDouble json d;
    7 Bytes stRawData json raw;
    8 string sMessage json msg;
    9 vector<int32_t> vNumbers json nums;
    10 vector<string> vWords json words;
    11 Inner stChild json child;
    12 vector<Inner> vChildren json children;
    13 map<int32_t, string> mTable json table;
    14 map<string, Inner> mNamed json named;
    15 uint8_t iUnsigned8 json u8;
    16 uint16_t iUnsigned16 json u16;
    17 uint32_t iUnsigned32 json u32;
    18 uint64_t iUnsigned64 json u64;
    19 vector<uint64_t> vUnsignedNumbers json unums;
    20 int32_t iGap json gap;
    21 map<uint32_t, string> mUnsignedTable json utable;
    22 map<uint64_t, string> mLargeUnsignedTable json ubig;
}

// UdpEchoReq.iSeq 取这些值时服务端回诊断，不回显。
enum UdpProbe {
    UDP_PROBE_PEER_ADDR = -1;
    UDP_PROBE_SESSIONS = -2;
    UDP_PROBE_REJECT = -3;
}

// 业务错误码用正数，框架错误码是负数。处理函数直接 co_return。
errordef UdpError {
    UDP_ERR_REJECTED = 1001;
}

// UDP 上的 RPC。iSeq 是 UdpProbe 时回诊断：对端地址、建过的会话数，或者回 UDP_ERR_REJECTED。
rpcdata UdpEchoReq {
    0 int32_t iSeq json seq;
    1 string sData json data;
}

rpcdata UdpEchoRes {
    0 int32_t iSeq json seq;
    1 string sData json data;
}

// UDP 上的单向消息。服务端收到后原样单向发回。
rpcdata UdpNoteReq {
    0 int32_t iSeq json seq;
}

// 单向消息不回包，生成器要求成对才留着。
rpcdata UdpNoteRes {
    0 int32_t iSeq json seq;
}

// 多连接回归。服务端回自己的 [Service] id；iNotify 非 0 时先顺着这条连接推一条 PeerNote 再回包。
rpcdata PeerProbeReq {
    0 int32_t iTag json tag;
    1 int32_t iNotify json notify;
}

rpcdata PeerProbeRes {
    0 int32_t iTag json tag;
    1 int32_t iServiceId json service_id;
}

// 服务端推给客户端的单向消息。
rpcdata PeerNoteReq {
    0 int32_t iTag json tag;
    1 int32_t iServiceId json service_id;
}

// 单向消息不回包，生成器要求成对才留着。
rpcdata PeerNoteRes {
    0 int32_t iTag json tag;
}

// 请求和回复共用一个协议号。调用号最高位区分请求和回包，调用号 0 是单向消息。
rpc AllEcho { id 3001; request AllEchoReq; response AllEchoRes; timeout 25; }
rpc Hold { id 3002; request HoldReq; response HoldRes; timeout 25; }
rpc UdpEcho { id 3003; request UdpEchoReq; response UdpEchoRes; timeout 25; }
rpc UdpNote { id 3004; request UdpNoteReq; response UdpNoteRes; timeout 25; }
rpc PeerProbe { id 3005; request PeerProbeReq; response PeerProbeRes; timeout 25; }
rpc PeerNote { id 3006; request PeerNoteReq; response PeerNoteRes; timeout 25; }
