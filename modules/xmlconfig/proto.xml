<Protocols>
  <!-- 字段默认按声明顺序从 0 编号。需要跳号时写 seq="N"，例如删掉 1 号字段后，后面的字段仍可保持原来的 seq。 -->

	<rpcdata name="Inner">
		<member type="int" name="n"/>
		<member type="std::string" name="s"/>
	</rpcdata>

	<rpcdata name="AllTypesData">
		<member type="char" name="c"/>
		<member type="short" name="s"/>
		<member type="int" name="i"/>
		<member type="long" name="l"/>
		<member type="int64_t" name="i64"/>
		<member type="float" name="f"/>
		<member type="double" name="d"/>
		<member type="Bytes" name="raw"/>
		<member type="std::string" name="msg"/>
		<member type="std::vector &lt; int &gt;" name="nums"/>
		<member type="std::vector &lt; std::string &gt;" name="words"/>
		<member type="Inner" name="child"/>
		<member type="std::vector &lt; Inner &gt;" name="children"/>
		<member type="std::map &lt; int, std::string &gt;" name="table"/>
		<member type="std::map &lt; std::string, Inner &gt;" name="named"/>
		<member type="int" name="gap" seq="20"/>
	</rpcdata>

	<rpcdata name="AllEchoReq">
		<member type="AllTypesData" name="data"/>
	</rpcdata>
	<rpcdata name="AllEchoRes">
		<member type="AllTypesData" name="data"/>
		<member type="int" name="code"/>
	</rpcdata>
	<rpc name="AllEcho" id="3001" res_id="3101" request="AllEchoReq" response="AllEchoRes" timeout="25"/>

	<rpcdata name="HoldReq">
		<member type="int" name="delay_ms"/>
		<member type="int" name="mark"/>
	</rpcdata>
	<rpcdata name="HoldRes">
		<member type="int" name="mark"/>
	</rpcdata>
	<rpc name="Hold" id="3002" res_id="3102" request="HoldReq" response="HoldRes" timeout="25"/>

</Protocols>
