# Packaged x64 SDKs. Other architectures retain the platform SDK discovery path.
option(OI_USE_BUNDLED_SDK "Use repository OpenSSL and MySQL client SDKs on supported platforms" ON)
set(OI_SDK_RUNTIME_FILES "" CACHE STRING "External runtime libraries to deploy (semicolon-separated absolute paths)")
if(OI_USE_BUNDLED_SDK AND CMAKE_SIZEOF_VOID_P EQUAL 8)
	if(WIN32 AND MSVC AND (MSVC_CXX_ARCHITECTURE_ID STREQUAL "x64" OR CMAKE_CXX_COMPILER_ARCHITECTURE_ID STREQUAL "x64" OR CMAKE_GENERATOR_PLATFORM STREQUAL "x64"))
		set(OI_SDK_DIR "${BASE_LIB_PATH}/3rd/prebuilt/windows-x64")
		set(OI_SSL_LINK "${OI_SDK_DIR}/lib/libssl.lib")
		set(OI_CRYPTO_LINK "${OI_SDK_DIR}/lib/libcrypto.lib")
		set(OI_MYSQL_LINK "${OI_SDK_DIR}/lib/libmariadb.lib")
		file(GLOB OI_SDK_RUNTIME "${OI_SDK_DIR}/bin/*.dll")
	elseif(CMAKE_SYSTEM_NAME STREQUAL "Linux" AND CMAKE_SYSTEM_PROCESSOR MATCHES "^(AMD64|amd64|x86_64|X86_64)$")
		set(OI_SDK_DIR "${BASE_LIB_PATH}/3rd/prebuilt/linux-x64")
		set(OI_SSL_LINK "${OI_SDK_DIR}/lib/libssl.so.3")
		set(OI_CRYPTO_LINK "${OI_SDK_DIR}/lib/libcrypto.so.3")
		set(OI_MYSQL_LINK "${OI_SDK_DIR}/lib/libmariadb.so.3")
		file(GLOB OI_SDK_RUNTIME "${OI_SDK_DIR}/lib/*.so*")
		list(APPEND CMAKE_BUILD_RPATH "$ORIGIN")
		list(APPEND CMAKE_INSTALL_RPATH "$ORIGIN")
	endif()
endif()
if(OI_SDK_DIR)
	add_library(oi_sdk_ssl INTERFACE)
	target_include_directories(oi_sdk_ssl SYSTEM INTERFACE "${OI_SDK_DIR}/include")
	target_link_libraries(oi_sdk_ssl INTERFACE "${OI_SSL_LINK}" "${OI_CRYPTO_LINK}")
	set(OI_MYSQL_INCLUDE_DIR "${OI_SDK_DIR}/include/mysql")
	set(OI_MYSQL_LIBRARY "${OI_MYSQL_LINK}")
endif()

if(NOT OI_SDK_DIR AND OI_SDK_RUNTIME_FILES)
	set(OI_SDK_RUNTIME ${OI_SDK_RUNTIME_FILES})
	if(CMAKE_SYSTEM_NAME STREQUAL "Linux")
		list(APPEND CMAKE_BUILD_RPATH "$ORIGIN")
		list(APPEND CMAKE_INSTALL_RPATH "$ORIGIN")
	endif()
endif()
# FindOpenSSL on MSVC normally selects import libraries by its own naming rules.
# Honor an explicit include directory and library pair literally on either platform.
if(NOT OI_SDK_DIR AND OPENSSL_INCLUDE_DIR AND OPENSSL_SSL_LIBRARY AND OPENSSL_CRYPTO_LIBRARY)
	add_library(oi_sdk_ssl INTERFACE)
	target_include_directories(oi_sdk_ssl SYSTEM INTERFACE "${OPENSSL_INCLUDE_DIR}")
	target_link_libraries(oi_sdk_ssl INTERFACE "${OPENSSL_SSL_LIBRARY}" "${OPENSSL_CRYPTO_LIBRARY}")
endif()